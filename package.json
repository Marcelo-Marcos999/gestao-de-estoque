{
  "name": "gestao-de-validades",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "node scripts/build-demo.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "npm run build && vite preview",
    "lint": "npm run lint:types && npm run lint:code && npm run lint:css",
    "lint:types": "tsc -b --noEmit",
    "lint:code": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "stylelint": "^17.14.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.9"
  }
}
