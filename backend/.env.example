# Copie para .env e preencha com valores de verdade. O .env nunca entra no git.

PORT=3000

# Conexão como app_runtime — a role de produção, SEM privilégio de dono.
# No Neon, use a connection string do pooler (porta do pgbouncer), não a direta.
DATABASE_URL=postgresql://app_runtime:SENHA_AQUI@HOST/BANCO?sslmode=require

# Conexão separada como app_auth — só enxerga lojas/administradores_plataforma,
# só SELECT. Usada exclusivamente no login.
AUTH_DATABASE_URL=postgresql://app_auth:OUTRA_SENHA_AQUI@HOST/BANCO?sslmode=require

# Gere cada um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reaproveite o mesmo valor pros dois.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Domínios que podem chamar a API, separados por vírgula. Sem '*'.
CORS_ORIGENS=http://localhost:5173

# Endereço do front-end, usado nos links dos e-mails (confirmar e-mail,
# redefinir senha). Sem barra no final. Nunca vem do cabeçalho da requisição.
APP_URL=http://localhost:5173

# Envio de e-mail. Sem isto, cadastro e "esqueci a senha" respondem 503.
#   resend  -> serviço real. Exige RESEND_API_KEY e EMAIL_REMETENTE, e o
#              domínio do remetente verificado no Resend.
#   console -> só escreve o e-mail no log (desenvolvimento). Ignorado quando
#              NODE_ENV=production, porque o link de recuperação é uma credencial.
EMAIL_PROVEDOR=console
# RESEND_API_KEY=
# EMAIL_REMETENTE=Gestão de Validades <nao-responda@seudominio.com.br>

# Arquivos dos anexos de quebra (fotos e PDFs), no R2 da Cloudflare.
# Crie em Cloudflare > R2 > Gerenciar tokens de API (permissão "Objeto: leitura e
# gravação" no bucket). Sem estas quatro, os anexos ficam desligados e a tela os
# esconde. O endereço sai do ID da conta; `R2_ENDPOINT` só serve para apontar a
# outro servidor compatível com S3 (testes).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=gestao-validades-anexos
